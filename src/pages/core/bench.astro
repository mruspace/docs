          <tr>
            <td>Apple M4</td>
            <td>macOS, Darwin 27.0</td>
            <td class="m">rustc 1.86.0</td>
            <td class="m">2026-10-11-darwin-arm64</td>
          </tr>
          <tr>
            <td>Arm Neoverse-N2</td>
            <td>Linux 6.17, GitHub Actions ubuntu-24.04-arm</td>
            <td class="m">rustc 1.99.0</td>
            <td class="m">2026-10-11-linux-aarch64</td>
          </tr>
          <tr>
            <td>AMD EPYC 7763</td>
            <td>Linux 6.17, GitHub Actions ubuntu-latest</td>
            <td class="m">rustc 1.99.0</td>
            <td class="m">2026-10-11-linux-x86_64</td>
          </tr>
