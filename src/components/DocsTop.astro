---
// Docs top bar (DocsTop artboard). Search: with JS, Pagefind results open
// under the field; without JS, the form searches the site with DuckDuckGo.
import Mark from './Mark.astro';
import { SITE } from '../data/site';
---

<header class="mru part docs-top">
  <div class="bar" style="padding-inline: var(--gut); max-width: 1440px; margin: 0 auto">
    <a class="brand" href="/" aria-label="Mru docs home">
      <Mark alt="" />
      <span class="word">Mru</span>
      <span class="sub">Docs</span>
    </a>
    <form class="search-form" role="search" action="https://duckduckgo.com/" method="get" data-search>
      <label class="search">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
          style="fill: none; stroke: currentColor; stroke-width: 1.6"
        >
          <circle cx="11" cy="11" r="6.5"></circle>
          <line x1="16" y1="16" x2="21" y2="21"></line>
        </svg>
        <span class="sr" style="position: absolute; left: -9999px">
          Search the docs
        </span>
        <input type="search" name="q" placeholder="Search docs" autocomplete="off" aria-controls="search-results" />
        <input type="hidden" name="sites" value="docs.mru.space" />
        <kbd>/</kbd>
      </label>
      <section
        class="search-results"
        id="search-results"
        aria-label="Search results"
        aria-live="polite"
        hidden
      ></section>
      <button type="submit" class="sr-only">
        Search
      </button>
    </form>
    <nav class="nav" aria-label="Docs header" style="flex: 0 1 auto; margin-left: auto">
      <a class="hide-s" href={SITE.github}>
        GitHub
      </a>
      <a class="hide-s" href={`${SITE.www}/research/`}>
        Research
      </a>
      <a href={`${SITE.www}/`}>Mru Aerospace</a>
      <a class="hide-s" href={`${SITE.www}/contact/`}>
        Get in touch
      </a>
    </nav>
  </div>
</header>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();

  // Start the header GIF at once. Mark.astro waits for the largest paint and
  // shows the static mark until then; the docs show only the GIF. The header
  // takes the 96 px copy (mru-96.gif, about 140 KB, sharp at 2x): the 600 px
  // original is 2 MB and would hold up the page text on a slow link. The
  // image the theme hides stays lazy, so it is never fetched.
  for (const img of document.querySelectorAll<HTMLImageElement>('.docs-top .mark-anim img[data-src]')) {
    img.addEventListener('load', () => img.closest('.mark-anim')?.classList.add('playing'), { once: true });
    img.fetchPriority = 'low';
    img.src = img.dataset.src!.replace(/\.gif$/, '-96.gif');
    img.removeAttribute('data-src');
  }
</script>
