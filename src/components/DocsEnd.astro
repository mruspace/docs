---
// The end of every docs page: previous / next, then "Updated", the source,
// "Edit on GitHub" and "Questions? Get in touch".
import { PAGES } from '../data/nav';
import { SITE } from '../data/site';

const path = Astro.url.pathname;
const i = PAGES.findIndex((p) => p.path === path);
if (i < 0) throw new Error(`nav.ts: no PAGES entry for ${path}`);
const page = PAGES[i]!;
const prev = PAGES[i - 1];
const next = PAGES[i + 1];
---

<div class="prevnext" style="margin-top: 56px">
  {prev ? (
    <a href={prev.path}>
      <span class="tiny">Previous</span>
      <span class="h4" style="display: block; font-family: var(--display)">
        {prev.short}
      </span>
    </a>
  ) : (
    <span />
  )}
  {next ? (
    <a href={next.path} class="next">
      <span class="tiny">Next</span>
      <span class="h4" style="display: block; font-family: var(--display)">
        {next.short}
      </span>
    </a>
  ) : (
    <a href="/" class="next">
      <span class="tiny">Back to</span>
      <span class="h4" style="display: block; font-family: var(--display)">
        Overview
      </span>
    </a>
  )}
</div>
<p class="tiny" style="margin-top: 32px">
  Updated {page.updated}
  {page.source && ` · Source: ${page.source}`} · <a href={`${SITE.repo}/edit/main/${page.file}`}>Edit on GitHub</a> ·{' '}
  <a href={`${SITE.www}/contact/`}>Questions? Get in touch</a>
</p>
